generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
    USER
    ADMIN
    SUPER_ADMIN
}

model User {
    id           String  @id @default(cuid())
    name         String
    email        String  @unique
    passwordHash String
    role         Role    @default(USER)
    phoneNumber  String?
    avatarUrl    String?

    isEmailVerified Boolean   @default(false)
    emailVerifiedAt DateTime?
    lastLoginAt     DateTime?
    loginAttempts   Int       @default(0)
    lockedUntil     DateTime?
    address         String?

    // forgetpassword
    otp          Int?
    otpExpiresAt DateTime?

    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
    reviews   Review[]
    bookings  Bookings[]

    @@index([createdAt])
}

enum CarType {
    SEDAN
    SUVs
    HATCHBACK
    LUXURY
    COMPACT_CARS
    ELECTRIC_CARS
    PREMIUM_SUV
    COMMERCIAL
}

enum TransmissionType {
    MANUAL
    AUTOMATIC
}

enum FuelType {
    PETROL
    DIESEL
    ELECTRIC
    CNG
    LPG
    HYBRID
}

model Car {
    id          String @id @default(cuid())

    brand       String
    model       String
    year        Int
    color       String
    plate       String @unique
    pricePerDay Float

    // car features
    totalSeat Int
    doors     Int
    mileage   String

    // car specs
    fuelType     FuelType
    transmission TransmissionType
    carType      CarType

    images   String[]
    videoUrl String?

    features      String[]
    safetyRatings String[]

    description String
    isAvailable Boolean @default(true)

    // timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    reviews           Review[]
    bookings          Bookings[]
    carAvailabilities CarAvailability[]
    driverInfo        DriverInfo?       @relation(fields: [driverInfoId], references: [id])
    driverInfoId      String?
}

model Review {
    id        String   @id @default(cuid())
    carId     String
    userId    String
    rating    Int
    comment   String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    car  Car  @relation(fields: [carId], references: [id])
    user User @relation(fields: [userId], references: [id])
}

enum BookingStatus {
    PENDING
    CONFIRMED
    COMPLETED
    CANCELLED
}

enum CarAvailabilityStatus {
    AVAILABLE
    BOOKED
    MAINTENANCE
}

model CarAvailability {
    id    String @id @default(cuid())
    carId String

    pickupDate     DateTime
    pickupTime     String
    pickupLocation String

    returnDate     DateTime
    returnTime     String
    returnLocation String

    status CarAvailabilityStatus @default(AVAILABLE)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    car Car @relation(fields: [carId], references: [id])
}

model Bookings {
    id               String  @id @default(cuid())
    bookingReference String? @unique

    carId  String
    userId String

    pickupDate     DateTime
    pickupTime     String
    pickupLocation String

    returnDate     DateTime
    returnTime     String
    returnLocation String

    rentalDays  Int?
    basePrice   Float?
    extrasPrice Float?
    discount    Float? @default(0)

    // payment
    totalPrice Float
    status     BookingStatus @default(PENDING)

    // Pay Now bookings stay PENDING until payment succeeds.
    // The car is held until this time, then the hold is released.
    holdExpiresAt DateTime?

    // timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    car  Car  @relation(fields: [carId], references: [id])
    user User @relation(fields: [userId], references: [id])

    driverInfoId String?
    driverInfo   DriverInfo? @relation(fields: [driverInfoId], references: [id])

    extraServices        ExtraService[]
    bookingPersonDetails BookingPersonDetails[]
    bookingDriverDetails BookingDriverDetails?
    airportShuttles      AirportShuttle[]
    payments             Payment[]
}

model ExtraService {
    id          String  @id @default(cuid())
    name        String
    pricePerDay Float
    isActive    Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    bookings Bookings[]
}

model BookingPersonDetails {
    id        String @id @default(cuid())
    bookingId String

    firstName   String
    lastName    String
    phoneNumber String
    email       String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    booking Bookings @relation(fields: [bookingId], references: [id])
}

model BookingDriverDetails {
    id        String @id @default(cuid())
    bookingId String @unique

    dateOfBirth   DateTime
    age           Int
    licenseState  String
    licenseNumber String
    licenseExpiry DateTime

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    booking Bookings @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model AirportShuttle {
    id             String  @id @default(cuid())
    bookingId      String
    shuttleService Boolean @default(false)

    price Float @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    booking Bookings @relation(fields: [bookingId], references: [id])
}

model DriverInfo {
    id String @id @default(cuid())

    name          String?
    phoneNumber   String?
    email         String?
    dateOfBirth   DateTime
    age           Int
    licenseNumber String
    licenseState  String
    licenseExpiry DateTime

    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
    cars      Car[]
    bookings  Bookings[]
}

model Payment {
    id        String @id @default(cuid())
    bookingId String

    paymentOption paymentOption

    paymentMethod String
    status        String
    amount        Float

    transactionId         String?
    stripePaymentIntentId String?
    cardLast4             String?
    cardBrand       String?
    billingStreet   String?
    billingSuburb   String?
    billingState    String?
    billingPostcode String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    booking Bookings @relation(fields: [bookingId], references: [id])
}

enum paymentOption {
    PAY_NOW
    PAY_AT_DESK
}

